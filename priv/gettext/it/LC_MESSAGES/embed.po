msgstr "Questa pagina di prenotazione non può essere incorporata qui"

#: lib/tymeslot_web/controllers/embed_blocked_html.ex
#, elixir-autogen, elixir-format
msgid "It may have been renamed, paused or removed. Please contact the organiser."
msgstr "Potrebbe essere stato rinominato, sospeso o rimosso. Contatta l’organizzatore."

#: lib/tymeslot_web/controllers/embed_blocked_html.ex
#, elixir-autogen, elixir-format
msgid "This meeting type isn’t available"
msgstr "Questo tipo di riunione non è disponibile"
